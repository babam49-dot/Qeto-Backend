// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAID_HELD
  COD_PENDING
  SHIPPED
  DELIVERED
  RELEASED
  DISPUTED
  REFUNDED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LedgerEntryType {
  HELD
  RELEASED
  REFUNDED
  COMMISSION
  PAYOUT_SENT
  COD_COMMISSION_OWED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum DisputeDecision {
  REFUND
  RELEASE
  PARTIAL
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String?  @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  stores    Store[]
}

model Store {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  description   String?
  logoUrl       String?
  phone         String
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id])
  products      Product[]
  orders        Order[]
  status        StoreStatus @default(TRIAL)
  trialEndsAt   DateTime    @default(now())
  commissionBps Int         @default(300)
  createdAt     DateTime    @default(now())
}

model Product {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  description String?
  imageUrls   String[]
  isPublished Boolean   @default(false)
  variants    Variant[]
  createdAt   DateTime  @default(now())

  @@index([storeId, isPublished])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  label      String
  priceCents Int
  stock      Int
  orderItems OrderItem[]

  @@index([productId])
}

model Order {
  id               String             @id @default(cuid())
  orderToken       String             @unique @default(cuid())
  storeId          String
  store            Store              @relation(fields: [storeId], references: [id])
  status           OrderStatus        @default(PENDING_PAYMENT)
  paymentMethod    String             @default("ONLINE")
  customerName     String
  phone            String
  address          String
  totalCents       Int
  deliveryCodeHash String?
  codeAttempts     Int                @default(0)
  shipDeadline     DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  releaseAt        DateTime?
  expiresAt        DateTime?
  items            OrderItem[]
  payments         Payment[]
  ledgerEntries    CommissionLedger[]
  dispute          Dispute?
  createdAt        DateTime           @default(now())

  @@index([storeId, status])
  @@index([status, expiresAt])
  @@index([storeId, status, releaseAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  variantId  String
  variant    Variant @relation(fields: [variantId], references: [id])
  quantity   Int
  priceCents Int
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  txRef       String        @unique
  amountCents Int
  status      PaymentStatus @default(PENDING)
  provider    String        @default("chapa")
  createdAt   DateTime      @default(now())
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventKey    String    @unique
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model CommissionLedger {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id])
  storeId     String
  type        LedgerEntryType
  amountCents Int
  note        String?
  createdAt   DateTime        @default(now())

  @@index([orderId])
  @@index([storeId])
}

model Dispute {
  id          String            @id @default(cuid())
  orderId     String            @unique
  order       Order             @relation(fields: [orderId], references: [id])
  openedBy    String
  reason      String
  status      DisputeStatus     @default(OPEN)
  decision    DisputeDecision?
  refundCents Int?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())
  evidence    DisputeEvidence[]
}

model DisputeEvidence {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id])
  author    String
  message   String
  imageUrl  String?
  createdAt DateTime @default(now())
}