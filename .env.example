# Database connection URL (direct connection recommended for Express servers)
DATABASE_URL="postgresql://user:password@ep-your-host.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# JWT Secret for signing authentication tokens (min 32 characters)
JWT_SECRET="replace_with_a_secure_random_string_at_least_32_characters_long"

# Application Port
PORT=4000

# Environment mode
NODE_ENV=development
